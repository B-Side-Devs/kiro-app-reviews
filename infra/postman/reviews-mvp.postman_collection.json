{
  "info": {
    "name": "Reviews MVP - Review Sessions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "018e0c5a-7b3f-7000-8000-000000000001" },
    { "key": "projectId", "value": "018e0c5c-2b3c-7000-8000-000000000001" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "Create Review Session",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-User-Id", "value": "{{userId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/v1/review-sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"projectId\": \"{{projectId}}\"\n}"
        }
      }
    },
    {
      "name": "Get Review Session",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "url": "{{baseUrl}}/api/v1/review-sessions/{{sessionId}}"
      }
    },
    {
      "name": "List Review Sessions by Project",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "url": "{{baseUrl}}/api/v1/review-sessions?projectId={{projectId}}"
      }
    }
  ]
}
