# =============================================================================
# Reviews — Local Development Environment: `.env` template
# =============================================================================
#
# This is the VERSIONED template of environment variables consumed by the
# local Docker Compose stack (`infra/docker/docker-compose.yml`). It documents
# every supported variable together with its default (non-sensitive) value.
#
# HOW TO USE (copy-and-edit workflow):
#
#   1. Copy this file to the REPOSITORY ROOT as `.env`:
#
#        # POSIX (bash / zsh)
#        cp infra/docker/.env.example .env
#
#        :: Windows (cmd.exe)
#        copy infra\docker\.env.example .env
#
#   2. Open the newly created `.env` and REPLACE the `CHANGE_ME` placeholder
#      of `POSTGRES_PASSWORD` with a real local-only password. The password
#      does NOT need to be strong — it lives on your machine only — but it
#      MUST be set (compose will refuse to start otherwise).
#
#   3. Run the environment with the operational script:
#
#        # POSIX
#        ./infra/docker/scripts/dev-up.sh
#
#        :: Windows
#        infra\docker\scripts\dev-up.cmd
#
# The developer-local `.env` is git-ignored (see the repository `.gitignore`).
# NEVER commit real credentials to this template — use `CHANGE_ME` or an
# empty value as a placeholder for anything sensitive.
#
# Variables you do NOT set here fall back to the defaults documented below.
# See `.kiro/specs/local-dev-environment/design.md` and `requirements.md`
# (Requirement 8) for the authoritative list.
#
# NOTE: This iteration of the spec only orchestrates the backend and postgres
# services. Any frontend-related variables are intentionally omitted and will
# be introduced by a future spec (see design.md deferred-scope banner and
# ADR-0004). Do not add frontend variables to this template.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------
# Prefix used by Docker Compose for project-scoped resources (containers,
# networks, volumes). Keeping a stable value avoids duplicate resource sets
# when the repository is checked out at different paths.
COMPOSE_PROJECT_NAME=reviews

# -----------------------------------------------------------------------------
# PostgreSQL (Servicio_Postgres)
# -----------------------------------------------------------------------------
# Database name created on first initialization.
POSTGRES_DB=reviews

# Application user owning the database.
POSTGRES_USER=reviews

# REQUIRED. Password for POSTGRES_USER. Compose will fail fast if this value
# is missing or empty (see `${POSTGRES_PASSWORD:?...}` in docker-compose.yml).
# Replace `CHANGE_ME` before running `dev-up`. Do NOT commit a real value.
POSTGRES_PASSWORD=CHANGE_ME

# Host port published for JDBC connections from tools like psql, DBeaver, or
# IntelliJ's Database tool window. Change this if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Backend (Servicio_Backend — Spring Boot)
# -----------------------------------------------------------------------------
# Host port published for the backend HTTP API and Spring Actuator. This is
# the port your Cliente_HTTP_Local (Postman, curl, HTTPie, IntelliJ HTTP
# Client, Bruno, Insomnia) connects to at `http://localhost:${BACKEND_HOST_PORT}`.
BACKEND_HOST_PORT=8080

# Host port published for the JDWP debug agent. Attach your IDE's remote
# debugger to `localhost:${BACKEND_DEBUG_PORT}` to step through backend code.
BACKEND_DEBUG_PORT=5005

# Active Spring profile(s). Keep `dev` to activate Spring DevTools (hot reload)
# and the development datasource configuration.
SPRING_PROFILES_ACTIVE=dev

# JVM options passed to the Spring Boot process inside the container. Tune the
# heap here if your machine is memory-constrained or if you want more headroom.
BACKEND_JAVA_OPTS=-Xmx1024m
